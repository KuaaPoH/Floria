# "mock" = dùng dữ liệu giả lập trên trình duyệt; "api" = kết nối Next.js API (/api/admin) + Firebase thật
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_URL=/api/admin

# Danh sách email được cấp quyền Super Admin mặc định khi đăng nhập Firebase Auth (phân tách bởi dấu phẩy)
ADMIN_EMAILS=

# Đường dẫn tới serviceAccountKey.json (mặc định tự tìm ../AI_Engine/serviceAccountKey.json)
# FIREBASE_SERVICE_ACCOUNT_PATH=../AI_Engine/serviceAccountKey.json

# URL các dịch vụ nội bộ
AI_ENGINE_URL=http://localhost:8000
SPRING_BACKEND_URL=http://localhost:8080
